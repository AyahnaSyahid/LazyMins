// src/utils/escpos.cpp
#include "escpos.h"

#include <QSerialPortInfo>
#include <QDebug>
#include <QByteArray>

// ==================== EscPosBuilder Implementation ====================

EscPosBuilder::EscPosBuilder()
    : m_currentAlignment(EscPos::Alignment::Left)
{
}

// ---------------------------------------------------------------------------
// Inisialisasi
// ---------------------------------------------------------------------------

EscPosBuilder& EscPosBuilder::reset()
{
    m_commands.clear();
    m_currentStyle    = EscPos::TextStyle();
    m_currentAlignment = EscPos::Alignment::Left;
    return *this;
}

EscPosBuilder& EscPosBuilder::initialize()
{
    // ESC @ — Initialize printer
    // Mereset semua pengaturan printer ke default.
    // Catatan: state internal builder juga direset agar sinkron.
    m_commands.append(EscPos::ESC);
    m_commands.append('@');
    m_currentStyle     = EscPos::TextStyle();
    m_currentAlignment = EscPos::Alignment::Left;
    return *this;
}

// ---------------------------------------------------------------------------
// Output teks
// ---------------------------------------------------------------------------

EscPosBuilder& EscPosBuilder::text(const QString& text)
{
    m_commands.append(text.toUtf8());
    return *this;
}

EscPosBuilder& EscPosBuilder::textStyled(const QString& text, const EscPos::TextStyle& style)
{
    // Simpan style sebelumnya
    const EscPos::TextStyle previousStyle = m_currentStyle;

    // Terapkan style baru — setiap helper memperbarui m_currentStyle
    bold(style.bold);
    underline(style.underline);
    italic(style.italic);

    // Terapkan magnifikasi melalui satu GS ! (hindari saling override)
    m_currentStyle.doubleWidth  = style.doubleWidth;
    m_currentStyle.doubleHeight = style.doubleHeight;
    appendSizeCommand();

    // Cetak teks
    this->text(text);

    // Kembalikan style sebelumnya
    bold(previousStyle.bold);
    underline(previousStyle.underline);
    italic(previousStyle.italic);
    m_currentStyle.doubleWidth  = previousStyle.doubleWidth;
    m_currentStyle.doubleHeight = previousStyle.doubleHeight;
    m_currentStyle.fontSize     = previousStyle.fontSize;
    appendSizeCommand();

    return *this;
}

EscPosBuilder& EscPosBuilder::newline(int count)
{
    for (int i = 0; i < count; ++i) {
        m_commands.append(EscPos::CR);
        m_commands.append(EscPos::LF);
    }
    return *this;
}

EscPosBuilder& EscPosBuilder::lineFeed(int count)
{
    for (int i = 0; i < count; ++i) {
        m_commands.append(EscPos::LF);
    }
    return *this;
}

// ---------------------------------------------------------------------------
// Alignment  —  ESC a n
// ---------------------------------------------------------------------------

EscPosBuilder& EscPosBuilder::align(EscPos::Alignment alignment)
{
    m_currentAlignment = alignment;
    m_commands.append(EscPos::ESC);
    m_commands.append('a');
    m_commands.append(static_cast<char>(alignment));
    return *this;
}

EscPosBuilder& EscPosBuilder::alignLeft()   { return align(EscPos::Alignment::Left);   }
EscPosBuilder& EscPosBuilder::alignCenter() { return align(EscPos::Alignment::Center); }
EscPosBuilder& EscPosBuilder::alignRight()  { return align(EscPos::Alignment::Right);  }

// ---------------------------------------------------------------------------
// Text style
// ---------------------------------------------------------------------------

EscPosBuilder& EscPosBuilder::bold(bool enable)
{
    m_currentStyle.bold = enable;
    // ESC E n — n=1: bold on, n=0: bold off
    m_commands.append(EscPos::ESC);
    m_commands.append('E');
    m_commands.append(enable ? '\x01' : '\x00');
    return *this;
}

EscPosBuilder& EscPosBuilder::underline(bool enable)
{
    m_currentStyle.underline = enable;
    // ESC - n — n=0: off, n=1: 1-dot, n=2: 2-dot
    m_commands.append(EscPos::ESC);
    m_commands.append('-');
    m_commands.append(enable ? '\x01' : '\x00');
    return *this;
}

EscPosBuilder& EscPosBuilder::italic(bool enable)
{
    m_currentStyle.italic = enable;
    // ESC 4 — italic on
    // ESC 5 — italic off
    // (Tidak semua printer mendukung; diabaikan secara diam-diam jika tidak didukung)
    m_commands.append(EscPos::ESC);
    m_commands.append(enable ? '4' : '5');
    return *this;
}

EscPosBuilder& EscPosBuilder::doubleHeight(bool enable)
{
    // Update state TERLEBIH DAHULU, lalu kirim GS ! dengan nilai gabungan.
    // Ini mencegah doubleWidth ter-reset saat doubleHeight diubah.
    m_currentStyle.doubleHeight = enable;
    m_currentStyle.fontSize     = EscPos::FontSize::Normal; // fontSize eksplisit dikosongkan
    appendSizeCommand();
    return *this;
}

EscPosBuilder& EscPosBuilder::doubleWidth(bool enable)
{
    m_currentStyle.doubleWidth  = enable;
    m_currentStyle.fontSize     = EscPos::FontSize::Normal;
    appendSizeCommand();
    return *this;
}

EscPosBuilder& EscPosBuilder::fontSize(EscPos::FontSize size)
{
    m_currentStyle.fontSize     = size;
    // Sinkronkan flag doubleWidth/doubleHeight agar konsisten dengan nilai size
    char n = static_cast<char>(size);
    m_currentStyle.doubleWidth  = ((n >> 4) & 0x07) >= 1;
    m_currentStyle.doubleHeight = (n & 0x07) >= 1;
    m_commands.append(EscPos::GS);
    m_commands.append('!');
    m_commands.append(n);
    return *this;
}

EscPosBuilder& EscPosBuilder::resetStyle()
{
    // Reset style satu per satu — JANGAN gunakan ESC @ karena itu me-reset
    // seluruh printer termasuk alignment dan line spacing.
    m_currentStyle = EscPos::TextStyle();

    // Bold off
    m_commands.append(EscPos::ESC);
    m_commands.append('E');
    m_commands.append('\x00');

    // Underline off
    m_commands.append(EscPos::ESC);
    m_commands.append('-');
    m_commands.append('\x00');

    // Italic off
    m_commands.append(EscPos::ESC);
    m_commands.append('5');

    // GS ! 0 — Normal size
    m_commands.append(EscPos::GS);
    m_commands.append('!');
    m_commands.append('\x00');

    return *this;
}

// ---------------------------------------------------------------------------
// Helper internal: kirim GS ! berdasarkan state m_currentStyle
// ---------------------------------------------------------------------------

void EscPosBuilder::appendSizeCommand()
{
    // Jika fontSize eksplisit di-set (bukan Normal dari doubleW/H),
    // gunakan nilai fontSize langsung.
    char n = static_cast<char>(m_currentStyle.fontSize);

    // Jika fontSize masih Normal, bangun byte dari flag boolean
    if (m_currentStyle.fontSize == EscPos::FontSize::Normal) {
        char widthMag  = m_currentStyle.doubleWidth  ? 1 : 0;
        char heightMag = m_currentStyle.doubleHeight ? 1 : 0;
        n = static_cast<char>((widthMag << 4) | heightMag);
    }

    m_commands.append(EscPos::GS);
    m_commands.append('!');
    m_commands.append(n);
}

// ---------------------------------------------------------------------------
// Garis & separator
// ---------------------------------------------------------------------------

EscPosBuilder& EscPosBuilder::horizontalLine(char character, int width)
{
    text(QString(width, QLatin1Char(character)));
    newline();
    return *this;
}

EscPosBuilder& EscPosBuilder::doubleLine(char character, int width)
{
    bold(true);
    text(QString(width, QLatin1Char(character)));
    bold(false);
    newline();
    return *this;
}

// ---------------------------------------------------------------------------
// Tabel & formatting
// ---------------------------------------------------------------------------

EscPosBuilder& EscPosBuilder::column(const QString& left, const QString& right, int width)
{
    text(formatColumn(left, right, width));
    newline();
    return *this;
}

EscPosBuilder& EscPosBuilder::tableRow(const QList<QString>& columns, const QList<int>& widths)
{
    if (columns.size() != widths.size())
        return *this;

    for (int i = 0; i < columns.size(); ++i) {
        QString col = columns[i].left(widths[i]);
        col += QString(widths[i] - col.length(), QLatin1Char(' '));
        text(col);
    }
    newline();
    return *this;
}

// ---------------------------------------------------------------------------
// Barcode  —  GS k (Form B)
//
// Urutan command:
//   1. GS H n  — set posisi HRI
//   2. GS h n  — set tinggi barcode
//   3. GS w n  — set lebar modul (multiplier)
//   4. GS k m n d1...dn  — cetak barcode (Form B: m=tipe, n=panjang data)
//
// Form B dipilih karena mendukung semua tipe termasuk CODE128,
// dan panjang data dikirim eksplisit sehingga aman untuk data yang mengandung NUL.
// ---------------------------------------------------------------------------

EscPosBuilder& EscPosBuilder::barcode(const QString& data,
                                      EscPos::BarcodeType type,
                                      int width,
                                      int height,
                                      EscPos::HRIPosition hri)
{
    const QByteArray barcodeData = data.toUtf8();
    const int dataLen = barcodeData.size();

    // Validasi panjang data (Form B: 1–255 byte)
    if (dataLen < 1 || dataLen > 255) {
        qWarning() << "EscPosBuilder::barcode: panjang data tidak valid:" << dataLen;
        return *this;
    }

    // Validasi lebar modul (2–6)
    const char moduleWidth = static_cast<char>(qBound(2, width, 6));

    // Validasi tinggi (1–255)
    const char barcodeHeight = static_cast<char>(qBound(1, height, 255));

    // GS H n — Select print position of HRI characters
    m_commands.append(EscPos::GS);
    m_commands.append('H');
    m_commands.append(static_cast<char>(hri));

    // GS h n — Set barcode height
    m_commands.append(EscPos::GS);
    m_commands.append('h');
    m_commands.append(barcodeHeight);

    // GS w n — Set barcode width (module multiplier)
    m_commands.append(EscPos::GS);
    m_commands.append('w');
    m_commands.append(moduleWidth);

    // GS k m n d1...dn — Print barcode (Form B)
    m_commands.append(EscPos::GS);
    m_commands.append('k');
    m_commands.append(static_cast<char>(type));      // m: tipe barcode
    m_commands.append(static_cast<char>(dataLen));   // n: panjang data
    m_commands.append(barcodeData);                  // d1...dn

    newline();
    return *this;
}

// ---------------------------------------------------------------------------
// QR Code  —  GS ( k
//
// Urutan function (sesuai Epson ESC/POS Command Reference):
//   Fn 165 (1A) — Select QR Code model
//   Fn 167 (1C) — Set module size
//   Fn 169 (1E) — Set error correction level
//   Fn 180 (1P) — Store symbol data
//   Fn 181 (1Q) — Print symbol data
//
// Format tiap sub-command:
//   GS ( k pL pH cn fn [params]
//   pL pH = panjang sisa data dalam byte (little-endian)
//   cn    = 0x31 ('1') untuk QR Code
// ---------------------------------------------------------------------------

EscPosBuilder& EscPosBuilder::qrCode(const QString& data,
                                     int moduleSize,
                                     EscPos::QRErrorCorrection errorCorrection,
                                     EscPos::QRModel model)
{
    const QByteArray qrData = data.toUtf8();
    const int dataLen = qrData.size();

    // Validasi
    if (dataLen < 1 || dataLen > 7089) {
        qWarning() << "EscPosBuilder::qrCode: panjang data tidak valid:" << dataLen;
        return *this;
    }
    const char modSize = static_cast<char>(qBound(1, moduleSize, 16));

    // --- Fn 165: Select QR Code model ---
    // pL pH = 4 (cn + fn + n1 + n2 = 4 byte setelah pL pH)
    m_commands.append(EscPos::GS);
    m_commands.append('(');
    m_commands.append('k');
    m_commands.append('\x04');              // pL
    m_commands.append('\x00');              // pH
    m_commands.append('1');                 // cn = 0x31
    m_commands.append('A');                 // fn = 0x41 (Function 165)
    m_commands.append(static_cast<char>(model)); // n1: model (0x31=Model1, 0x32=Model2)
    m_commands.append('\x00');              // n2: reserved

    // --- Fn 167: Set module size ---
    // pL pH = 3 (cn + fn + n = 3 byte)
    m_commands.append(EscPos::GS);
    m_commands.append('(');
    m_commands.append('k');
    m_commands.append('\x03');              // pL
    m_commands.append('\x00');              // pH
    m_commands.append('1');                 // cn = 0x31
    m_commands.append('C');                 // fn = 0x43 (Function 167)
    m_commands.append(modSize);             // n: ukuran modul (1–16)

    // --- Fn 169: Set error correction level ---
    // pL pH = 3 (cn + fn + n = 3 byte)
    m_commands.append(EscPos::GS);
    m_commands.append('(');
    m_commands.append('k');
    m_commands.append('\x03');              // pL
    m_commands.append('\x00');              // pH
    m_commands.append('1');                 // cn = 0x31
    m_commands.append('E');                 // fn = 0x45 (Function 169)
    m_commands.append(static_cast<char>(errorCorrection)); // n: level ('0'–'3')

    // --- Fn 180: Store QR data ---
    // pL pH = (dataLen + 3), karena payload = cn + fn + m + data
    // pL pH adalah 2 byte little-endian dari total panjang field setelah pL pH
    const int storePayloadLen = dataLen + 3; // cn(1) + fn(1) + m(1) + data(n)
    m_commands.append(EscPos::GS);
    m_commands.append('(');
    m_commands.append('k');
    m_commands.append(static_cast<char>(storePayloadLen & 0xFF));          // pL
    m_commands.append(static_cast<char>((storePayloadLen >> 8) & 0xFF));   // pH
    m_commands.append('1');                 // cn = 0x31
    m_commands.append('P');                 // fn = 0x50 (Function 180)
    m_commands.append('0');                 // m  = 0x30 (harus '0')
    m_commands.append(qrData);              // d1...dk — data QR

    // --- Fn 181: Print QR Code ---
    // pL pH = 3 (cn + fn + m = 3 byte)
    m_commands.append(EscPos::GS);
    m_commands.append('(');
    m_commands.append('k');
    m_commands.append('\x03');              // pL
    m_commands.append('\x00');              // pH
    m_commands.append('1');                 // cn = 0x31
    m_commands.append('Q');                 // fn = 0x51 (Function 181)
    m_commands.append('0');                 // m  = 0x30

    newline();
    return *this;
}

// ---------------------------------------------------------------------------
// Image raster  —  GS v 0
//
// Command: GS v 0 m xL xH yL yH d1...dk
//   m      : mode (0=normal, 1=double-width, 2=double-height, 3=4x)
//   xL xH  : lebar dalam byte (LSB/MSB) — pixels/8, sudah dipadding ke kelipatan 8
//   yL yH  : tinggi dalam dot  (LSB/MSB)
//   d1...dk: data bitmap, 1 bit per pixel, MSB = piksel kiri
//
// PENTING: Gunakan GS v 0, bukan GS * (ESC *) yang merupakan column-format
//          bit image mode yang bekerja secara berbeda.
// ---------------------------------------------------------------------------

EscPosBuilder& EscPosBuilder::image(const QByteArray& imageData, int widthBytes, int height, char mode)
{
    if (imageData.isEmpty() || widthBytes <= 0 || height <= 0) {
        qWarning() << "EscPosBuilder::image: parameter tidak valid";
        return *this;
    }

    // Validasi ukuran data
    const int expectedSize = widthBytes * height;
    if (imageData.size() < expectedSize) {
        qWarning() << "EscPosBuilder::image: ukuran data tidak sesuai."
                   << "Diharapkan:" << expectedSize << "Diterima:" << imageData.size();
        return *this;
    }

    // GS v 0
    m_commands.append(EscPos::GS);
    m_commands.append('v');
    m_commands.append('0');
    m_commands.append(mode & 0x03);                                     // m: mode (0–3)
    m_commands.append(static_cast<char>(widthBytes & 0xFF));            // xL
    m_commands.append(static_cast<char>((widthBytes >> 8) & 0xFF));     // xH
    m_commands.append(static_cast<char>(height & 0xFF));                // yL
    m_commands.append(static_cast<char>((height >> 8) & 0xFF));         // yH
    m_commands.append(imageData.left(expectedSize));                    // d1...dk

    return *this;
}

// ---------------------------------------------------------------------------
// Cash drawer  —  ESC p pin onTime offTime
//   pin     : 0=pin2, 1=pin5
//   onTime  : durasi sinyal ON  (× 2ms)
//   offTime : durasi sinyal OFF (× 2ms)
// ---------------------------------------------------------------------------

EscPosBuilder& EscPosBuilder::openDrawer(EscPos::DrawerPin pin, int onTime, int offTime)
{
    m_commands.append(EscPos::ESC);
    m_commands.append('p');
    m_commands.append(static_cast<char>(pin));
    m_commands.append(static_cast<char>(qBound(0, onTime,  255)));
    m_commands.append(static_cast<char>(qBound(0, offTime, 255)));
    return *this;
}

// ---------------------------------------------------------------------------
// Pemotongan kertas  —  GS V
// ---------------------------------------------------------------------------

EscPosBuilder& EscPosBuilder::fullCut()
{
    // GS V \x00 — Full cut (tidak ada sisa kertas)
    m_commands.append(EscPos::GS);
    m_commands.append('V');
    m_commands.append('\x00');
    return *this;
}

EscPosBuilder& EscPosBuilder::partialCut()
{
    // GS V \x01 — Partial cut (kertas tidak terputus sepenuhnya)
    m_commands.append(EscPos::GS);
    m_commands.append('V');
    m_commands.append('\x01');
    return *this;
}

EscPosBuilder& EscPosBuilder::cutAndFeed(int feedLines)
{
    // GS V 'A' n — Feed n lines, lalu full cut
    // (GS V m=65/'A' sesuai spesifikasi Epson untuk cut-with-feed)
    m_commands.append(EscPos::GS);
    m_commands.append('V');
    m_commands.append('A');
    m_commands.append(static_cast<char>(qBound(0, feedLines, 255)));
    return *this;
}

// ---------------------------------------------------------------------------
// Buzzer / Beeper  —  ESC B count onTime offTime
//   Beberapa printer menggunakan command proprietary; BEL (\x07) adalah
//   fallback universal yang mengaktifkan buzzer dengan parameter default printer.
//   Di sini kita implementasikan ESC B (didukung banyak thermal printer).
// ---------------------------------------------------------------------------

EscPosBuilder& EscPosBuilder::buzz(int count, int onTime, int offTime)
{
    // ESC B n t1 t2
    //   n  : jumlah bunyi (1–9)
    //   t1 : durasi ON  × 100ms (1–9)
    //   t2 : durasi OFF × 100ms (1–9)
    const char n  = static_cast<char>(qBound(1, count,   9));
    const char t1 = static_cast<char>(qBound(1, onTime,  9));
    const char t2 = static_cast<char>(qBound(1, offTime, 9));

    m_commands.append(EscPos::ESC);
    m_commands.append('B');
    m_commands.append(n);
    m_commands.append(t1);
    m_commands.append(t2);
    return *this;
}

// ---------------------------------------------------------------------------
// Status printer  —  DLE EOT n
// ---------------------------------------------------------------------------

EscPosBuilder& EscPosBuilder::queryPaperStatus()
{
    // DLE EOT 4 — Transmit paper sensor status
    m_commands.append(EscPos::DLE);
    m_commands.append(EscPos::EOT);
    m_commands.append('\x04');
    return *this;
}

EscPosBuilder& EscPosBuilder::queryPrinterStatus()
{
    // DLE EOT 1 — Transmit printer status
    m_commands.append(EscPos::DLE);
    m_commands.append(EscPos::EOT);
    m_commands.append('\x01');
    return *this;
}

// ---------------------------------------------------------------------------
// Build & clear
// ---------------------------------------------------------------------------

QByteArray EscPosBuilder::build() const
{
    return m_commands;
}

QString EscPosBuilder::buildAsString() const
{
    return QString::fromUtf8(m_commands);
}

void EscPosBuilder::clear()
{
    m_commands.clear();
    m_currentStyle     = EscPos::TextStyle();
    m_currentAlignment = EscPos::Alignment::Left;
}

// ---------------------------------------------------------------------------
// Private helpers
// ---------------------------------------------------------------------------

QString EscPosBuilder::formatColumn(const QString& left, const QString& right, int width) const
{
    int spaceBetween = width - left.length() - right.length();
    if (spaceBetween < 1) spaceBetween = 1;
    return left + QString(spaceBetween, QLatin1Char(' ')) + right;
}


// ==================== EscPosPrinter Implementation ====================

EscPosPrinter::EscPosPrinter(const QString& portName)
    : m_port(nullptr)
{
    if (!portName.isEmpty())
        connect(portName);
}

EscPosPrinter::~EscPosPrinter()
{
    disconnect();
}

// ---------------------------------------------------------------------------
// Manajemen koneksi
// ---------------------------------------------------------------------------

bool EscPosPrinter::connect(const QString& portName, int baudRate)
{
    if (m_port && m_port->isOpen())
        disconnect();

    m_port = new QSerialPort();
    m_port->setPortName(portName);
    m_port->setBaudRate(baudRate);
    m_port->setDataBits(QSerialPort::Data8);
    m_port->setStopBits(QSerialPort::OneStop);
    m_port->setParity(QSerialPort::NoParity);
    m_port->setFlowControl(QSerialPort::NoFlowControl);

    if (!m_port->open(QIODevice::WriteOnly)) {
        setError(QString("Tidak bisa membuka port %1: %2")
                     .arg(portName, m_port->errorString()));
        delete m_port;
        m_port = nullptr;
        return false;
    }

    m_lastError.clear();
    qDebug() << "EscPosPrinter: terhubung ke" << portName << "@" << baudRate;
    return true;
}

bool EscPosPrinter::disconnect()
{
    if (m_port) {
        if (m_port->isOpen())
            m_port->close();
        m_port->deleteLater();
        m_port = nullptr;
    }
    return true;
}

bool EscPosPrinter::isConnected() const
{
    return m_port && m_port->isOpen();
}

// ---------------------------------------------------------------------------
// Manajemen port
// ---------------------------------------------------------------------------

QStringList EscPosPrinter::availablePorts() const
{
    QStringList ports;
    for (const auto& info : QSerialPortInfo::availablePorts())
        ports << info.portName();
    return ports;
}

QString EscPosPrinter::currentPort() const
{
    return isConnected() ? m_port->portName() : QString();
}

// ---------------------------------------------------------------------------
// Pengiriman command
// ---------------------------------------------------------------------------

bool EscPosPrinter::sendCommand(const QByteArray& command)
{
    if (command.isEmpty())
        return true;

    if (!isConnected()) {
        setError("Printer tidak terhubung");
        return false;
    }

    qint64 written = m_port->write(command);
    if (written != static_cast<qint64>(command.size())) {
        setError(QString("Gagal menulis ke port: ditulis %1 dari %2 byte")
                     .arg(written).arg(command.size()));
        return false;
    }

    if (!m_port->waitForBytesWritten(3000)) {
        setError("Timeout saat mengirim data ke printer: " + m_port->errorString());
        return false;
    }

    m_lastError.clear();
    return true;
}

bool EscPosPrinter::sendCommand(const EscPosBuilder& builder)
{
    return sendCommand(builder.build());
}

bool EscPosPrinter::sendRawBytes(const QByteArray& bytes)
{
    return sendCommand(bytes);
}

// ---------------------------------------------------------------------------
// Status printer
// ---------------------------------------------------------------------------

bool EscPosPrinter::checkStatus()
{
    if (!isConnected()) {
        setError("Printer tidak terhubung");
        return false;
    }

    // Buka port sebagai ReadWrite sementara untuk membaca response
    // (port dibuka WriteOnly saat connect(); buka ulang jika perlu baca)
    EscPosBuilder builder;
    builder.queryPaperStatus();

    if (!sendCommand(builder))
        return false;

    if (m_port->waitForReadyRead(1500)) {
        const QByteArray response = m_port->readAll();
        qDebug() << "Printer status response (hex):" << response.toHex();
        // Bit 2 dari byte status paper sensor: 1 = paper near-end, Bit 3: 1 = paper end
        return true;
    }

    setError("Tidak ada response dari printer");
    return false;
}

QString EscPosPrinter::lastError() const  { return m_lastError; }
void    EscPosPrinter::clearError()       { m_lastError.clear(); }

// ---------------------------------------------------------------------------
// Convenience methods
// ---------------------------------------------------------------------------

bool EscPosPrinter::printText(const QString& text)
{
    EscPosBuilder builder;
    builder.text(text).newline();
    return sendCommand(builder);
}

bool EscPosPrinter::printLine(char character, int width)
{
    EscPosBuilder builder;
    builder.horizontalLine(character, width);
    return sendCommand(builder);
}

bool EscPosPrinter::printSeparator()
{
    return printLine('=', 32);
}

bool EscPosPrinter::testPrint()
{
    EscPosBuilder builder;

    builder.initialize();

    // Header — center, bold
    builder.alignCenter();
    builder.bold(true);
    builder.text("TEST PRINT").newline();
    builder.bold(false);
    builder.text("ESC/POS Printer").newline();
    builder.horizontalLine('=', 32);

    // Info — left
    builder.alignLeft();
    builder.text("Status : OK").newline();
    builder.text("Baud   : ").text(QString::number(currentBaud())).newline();
    builder.text("Port   : ").text(currentPort()).newline();
    builder.horizontalLine('-', 32);

    // Style test
    builder.bold(true);
    builder.text("Bold text").newline();
    builder.bold(false);

    builder.underline(true);
    builder.text("Underline text").newline();
    builder.underline(false);

    builder.doubleWidth(true);
    builder.text("Dbl Width").newline();
    builder.doubleWidth(false);

    builder.doubleHeight(true);
    builder.text("Dbl Height").newline();
    builder.doubleHeight(false);

    builder.doubleWidth(true);
    builder.doubleHeight(true);
    builder.text("Dbl W+H").newline();
    builder.doubleWidth(false);
    builder.doubleHeight(false);

    builder.horizontalLine('=', 32);

    // Footer — center
    builder.alignCenter();
    builder.text("Printer OK!").newline();
    builder.lineFeed(4);
    builder.partialCut();

    return sendCommand(builder);
}

// ---------------------------------------------------------------------------
// Private
// ---------------------------------------------------------------------------

void EscPosPrinter::setError(const QString& error)
{
    m_lastError = error;
    qWarning() << "EscPosPrinter Error:" << error;
}
