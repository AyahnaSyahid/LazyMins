// src/utils/escpos.h
#pragma once

#include <QString>
#include <QByteArray>
#include <QList>
#include <QSerialPort>

// ==================== ESC/POS Constants ====================

namespace EscPos {

    // ---------------------------------------------------------------------------
    // Control characters — tipe char tunggal agar append(char) dipanggil secara
    // eksplisit, bukan append(const char*) yang mengandalkan null-terminator.
    // ---------------------------------------------------------------------------
    static constexpr char ESC = '\x1B';   // Escape
    static constexpr char GS  = '\x1D';   // Group Separator
    static constexpr char DLE = '\x10';   // Data Link Escape (real-time command)
    static constexpr char EOT = '\x04';   // End Of Transmission
    static constexpr char CR  = '\x0D';   // Carriage Return
    static constexpr char LF  = '\x0A';   // Line Feed
    static constexpr char HT  = '\x09';   // Horizontal Tab
    static constexpr char BEL = '\x07';   // Bell / Buzzer

    // ---------------------------------------------------------------------------
    // Alignment  —  ESC a n  (standar Epson)
    // ---------------------------------------------------------------------------
    enum class Alignment : char {
        Left   = 0x00,
        Center = 0x01,
        Right  = 0x02
    };

    // ---------------------------------------------------------------------------
    // GS ! n — Select character size
    //
    // Bit layout (1 byte):
    //   bit 2-0 : height magnification  (0=1×, 1=2×, 2=3×, 3=4×)
    //   bit 6-4 : width  magnification  (0=1×, 1=2×, 2=3×, 3=4×)
    //   bit 3, 7: reserved (0)
    //
    //   Formula : n = (widthMag << 4) | heightMag
    //             widthMag  = (n >> 4) & 0x07
    //             heightMag = n & 0x07
    // ---------------------------------------------------------------------------
    enum class FontSize : char {
        Normal          = 0x00,   // 1× width, 1× height
        DoubleHeight    = 0x01,   // 1× width, 2× height
        DoubleWidth     = 0x10,   // 2× width, 1× height
        DoubleWidthHeight = 0x11, // 2× width, 2× height
        TripleHeight    = 0x02,   // 1× width, 3× height
        TripleWidth     = 0x20,   // 3× width, 1× height
        Large           = 0x22,   // 3× width, 3× height
        ExtraLarge      = 0x33    // 4× width, 4× height
    };

    // ---------------------------------------------------------------------------
    // Text style — state yang dijaga oleh EscPosBuilder
    // ---------------------------------------------------------------------------
    struct TextStyle {
        bool bold        = false;
        bool underline   = false;
        bool italic      = false;
        bool doubleWidth = false;
        bool doubleHeight= false;
        FontSize fontSize = FontSize::Normal;
    };

    // ---------------------------------------------------------------------------
    // Barcode type — GS k, Form B (n = 65–73, mendukung semua tipe)
    //
    //   Form B menerima panjang data eksplisit setelah byte tipe, sehingga data
    //   dapat mengandung NUL. Nilai desimal = ASCII offset dari 'A' (65).
    // ---------------------------------------------------------------------------
    enum class BarcodeType : char {
        UPC_A   = 65,   // 0x41
        UPC_E   = 66,   // 0x42
        EAN13   = 67,   // 0x43  (JAN13)
        EAN8    = 68,   // 0x44  (JAN8)
        CODE39  = 69,   // 0x45
        ITF     = 70,   // 0x46  (Interleaved 2 of 5)
        CODABAR = 71,   // 0x47  (NW-7)
        CODE93  = 72,   // 0x48
        CODE128 = 73    // 0x49
    };

    // ---------------------------------------------------------------------------
    // QR Code error correction level  —  GS ( k, fn=69 ('E')
    //   Nilai ASCII karakter '0'–'3' sesuai spesifikasi Epson.
    // ---------------------------------------------------------------------------
    enum class QRErrorCorrection : char {
        Low      = '0',   // 0x30 — ~7%  recovery capacity
        Medium   = '1',   // 0x31 — ~15% recovery capacity
        Quartile = '2',   // 0x32 — ~25% recovery capacity
        High     = '3'    // 0x33 — ~30% recovery capacity
    };

    // ---------------------------------------------------------------------------
    // QR Code model
    // ---------------------------------------------------------------------------
    enum class QRModel : char {
        Model1 = '1',   // Model 1 (lama, jarang dipakai)
        Model2 = '2'    // Model 2 (standar, direkomendasikan)
    };

    // ---------------------------------------------------------------------------
    // Barcode HRI (Human Readable Interpretation) position  —  GS H n
    // ---------------------------------------------------------------------------
    enum class HRIPosition : char {
        None  = 0x00,
        Above = 0x01,
        Below = 0x02,
        Both  = 0x03
    };

    // ---------------------------------------------------------------------------
    // Cash drawer pin
    // ---------------------------------------------------------------------------
    enum class DrawerPin : char {
        Pin2 = 0x00,
        Pin5 = 0x01
    };

} // namespace EscPos


// ==================== ESC/POS Command Builder ====================

class EscPosBuilder {
public:
    EscPosBuilder();

    // -----------------------------------------------------------------------
    // Inisialisasi
    // -----------------------------------------------------------------------

    // Bersihkan buffer builder dan reset state internal (tidak kirim ke printer)
    EscPosBuilder& reset();

    // ESC @ — Inisialisasi printer (kirim ke printer, reset semua pengaturan)
    EscPosBuilder& initialize();

    // -----------------------------------------------------------------------
    // Output teks
    // -----------------------------------------------------------------------

    EscPosBuilder& text(const QString& text);
    EscPosBuilder& textStyled(const QString& text, const EscPos::TextStyle& style);
    EscPosBuilder& newline(int count = 1);
    EscPosBuilder& lineFeed(int count = 1);

    // -----------------------------------------------------------------------
    // Alignment  —  ESC a n
    // -----------------------------------------------------------------------

    EscPosBuilder& align(EscPos::Alignment alignment);
    EscPosBuilder& alignLeft();
    EscPosBuilder& alignCenter();
    EscPosBuilder& alignRight();

    // -----------------------------------------------------------------------
    // Text style
    // -----------------------------------------------------------------------

    // ESC E n — Bold
    EscPosBuilder& bold(bool enable = true);

    // ESC - n — Underline (0=off, 1=1-dot, 2=2-dot)
    EscPosBuilder& underline(bool enable = true);

    // ESC 4 / ESC 5 — Italic (tidak semua printer mendukung)
    EscPosBuilder& italic(bool enable = true);

    // GS ! n — Double height (dikombinasikan dengan doubleWidth jika aktif)
    EscPosBuilder& doubleHeight(bool enable = true);

    // GS ! n — Double width (dikombinasikan dengan doubleHeight jika aktif)
    EscPosBuilder& doubleWidth(bool enable = true);

    // GS ! n — Set ukuran karakter secara eksplisit
    //          Catatan: me-reset state doubleWidth/doubleHeight sesuai nilai size.
    EscPosBuilder& fontSize(EscPos::FontSize size);

    // Reset style: matikan bold, underline, italic, dan GS ! ke Normal.
    // Tidak mengirim ESC @ agar alignment & line-spacing tidak ikut reset.
    EscPosBuilder& resetStyle();

    // -----------------------------------------------------------------------
    // Garis & separator
    // -----------------------------------------------------------------------

    EscPosBuilder& horizontalLine(char character = '-', int width = 32);
    EscPosBuilder& doubleLine(char character = '=', int width = 32);

    // -----------------------------------------------------------------------
    // Tabel & formatting
    // -----------------------------------------------------------------------

    EscPosBuilder& column(const QString& left, const QString& right, int width = 32);
    EscPosBuilder& tableRow(const QList<QString>& columns, const QList<int>& widths);

    // -----------------------------------------------------------------------
    // Barcode  —  GS k (Form B)
    //   width  : module width multiplier, 2–6 (default 3)
    //   height : barcode height dalam dot, 1–255 (default 50)
    //   hri    : posisi Human Readable Interpretation
    // -----------------------------------------------------------------------
    EscPosBuilder& barcode(const QString& data,
                           EscPos::BarcodeType type,
                           int width  = 3,
                           int height = 50,
                           EscPos::HRIPosition hri = EscPos::HRIPosition::Below);

    // -----------------------------------------------------------------------
    // QR Code  —  GS ( k (Function 165, 167, 169, 180, 181)
    //   moduleSize      : ukuran modul dalam dot, 1–16 (default 4)
    //   errorCorrection : level koreksi error
    //   model           : QR Model 1 atau 2 (default Model2)
    // -----------------------------------------------------------------------
    EscPosBuilder& qrCode(const QString& data,
                          int moduleSize = 4,
                          EscPos::QRErrorCorrection errorCorrection = EscPos::QRErrorCorrection::High,
                          EscPos::QRModel model = EscPos::QRModel::Model2);

    // -----------------------------------------------------------------------
    // Image raster  —  GS v 0  (bukan GS *)
    //   imageData : data bitmap 1-bit, MSB first, lebar harus kelipatan 8 bit
    //   widthBytes: lebar dalam byte  (pixels / 8, sudah dipadding)
    //   height    : tinggi dalam dot/baris
    //   mode      : 0=normal, 1=double-width, 2=double-height, 3=4x
    // -----------------------------------------------------------------------
    EscPosBuilder& image(const QByteArray& imageData, int widthBytes, int height, char mode = 0);

    // -----------------------------------------------------------------------
    // Cash drawer  —  ESC p
    //   pin      : DrawerPin::Pin2 atau DrawerPin::Pin5
    //   onTime   : durasi sinyal ON  dalam satuan 2ms (default 60 = 120ms)
    //   offTime  : durasi sinyal OFF dalam satuan 2ms (default 120 = 240ms)
    // -----------------------------------------------------------------------
    EscPosBuilder& openDrawer(EscPos::DrawerPin pin = EscPos::DrawerPin::Pin2,
                              int onTime  = 60,
                              int offTime = 120);

    // -----------------------------------------------------------------------
    // Pemotongan kertas  —  GS V
    // -----------------------------------------------------------------------

    // GS V \x00 — Full cut
    EscPosBuilder& fullCut();

    // GS V \x01 — Partial cut
    EscPosBuilder& partialCut();

    // GS V m n — Full cut dengan feed sejumlah feedLines baris
    EscPosBuilder& cutAndFeed(int feedLines = 3);

    // -----------------------------------------------------------------------
    // Buzzer / Beeper
    //   count  : jumlah bunyi (1–9)
    //   onTime : durasi ON  dalam satuan 100ms
    //   offTime: durasi OFF dalam satuan 100ms
    //   Jika printer tidak mendukung ESC B, gunakan BEL (\x07).
    // -----------------------------------------------------------------------
    EscPosBuilder& buzz(int count = 1, int onTime = 2, int offTime = 2);

    // -----------------------------------------------------------------------
    // Status printer  —  DLE EOT n
    //   n=1: Printer status, n=2: Offline status, n=3: Error status,
    //   n=4: Paper roll sensor status
    // -----------------------------------------------------------------------
    EscPosBuilder& queryPaperStatus();
    EscPosBuilder& queryPrinterStatus();

    // -----------------------------------------------------------------------
    // Akses hasil build
    // -----------------------------------------------------------------------

    QByteArray build() const;
    QString    buildAsString() const;
    int        size() const { return m_commands.size(); }

    // Bersihkan buffer builder (sama dengan reset())
    void clear();

private:
    QByteArray         m_commands;
    EscPos::TextStyle  m_currentStyle;
    EscPos::Alignment  m_currentAlignment;

    // Kirim command GS ! berdasarkan state m_currentStyle saat ini
    void appendSizeCommand();

    // Helper format kolom
    QString formatColumn(const QString& left, const QString& right, int width) const;
};


// ==================== ESC/POS Printer ====================

class EscPosPrinter {
public:
    explicit EscPosPrinter(const QString& portName = "");
    ~EscPosPrinter();

    // -----------------------------------------------------------------------
    // Manajemen koneksi
    // -----------------------------------------------------------------------

    bool connect(const QString& portName, int baudRate = 9600);
    bool disconnect();
    bool isConnected() const;

    // -----------------------------------------------------------------------
    // Manajemen port
    // -----------------------------------------------------------------------

    QStringList availablePorts() const;
    QString     currentPort() const;
    qint32      currentBaud(QSerialPort::Directions directions = QSerialPort::AllDirections) const
    {
        return isConnected() ? m_port->baudRate(directions) : -1;
    }

    // -----------------------------------------------------------------------
    // Pengiriman command
    // -----------------------------------------------------------------------

    bool sendCommand(const QByteArray& command);
    bool sendCommand(const EscPosBuilder& builder);
    bool sendRawBytes(const QByteArray& bytes);

    // -----------------------------------------------------------------------
    // Status printer
    // -----------------------------------------------------------------------

    bool    checkStatus();
    QString lastError() const;
    void    clearError();

    // -----------------------------------------------------------------------
    // Convenience methods
    // -----------------------------------------------------------------------

    bool printText(const QString& text);
    bool printLine(char character = '-', int width = 32);
    bool printSeparator();
    bool testPrint();

private:
    QSerialPort* m_port;
    QString      m_lastError;

    void setError(const QString& error);
};
